rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'uandimiles@gmail.com';
    }

    match /portfolio_works/{workId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /portfolio_profile/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
